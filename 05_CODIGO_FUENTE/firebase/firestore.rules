rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function currentUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isActive() {
      return isAuthenticated() && currentUser().status == 'ACTIVE';
    }

    function hasRole(role) {
      return isActive() && currentUser().role == role;
    }

    function isAdmin() {
      return hasRole('ADMIN');
    }

    function isTechnician() {
      return hasRole('TECNICO');
    }

    function isRequester() {
      return hasRole('SOLICITANTE');
    }

    match /users/{userId} {
      allow read: if isActive() &&
        (request.auth.uid == userId || isAdmin());
      allow create, update, delete: if isAdmin();
    }

    match /tickets/{ticketId} {
      allow create: if isActive()
        && request.resource.data.requesterId == request.auth.uid
        && request.resource.data.status == 'ABIERTO';

      allow read: if isActive() && (
        isAdmin()
        || isTechnician()
        || resource.data.requesterId == request.auth.uid
      );

      allow update: if isAdmin() || isTechnician();
      allow delete: if false;
    }

    match /ticketComments/{commentId} {
      allow create: if isActive()
        && request.resource.data.authorId == request.auth.uid;
      allow read: if isActive();
      allow update, delete: if false;
    }

    match /ticketHistory/{historyId} {
      allow read: if isAdmin() || isTechnician();
      allow create: if false; // Solo Cloud Functions con Admin SDK
      allow update, delete: if false;
    }

    match /categories/{categoryId} {
      allow read: if isActive();
      allow write: if isAdmin();
    }

    match /slaPolicies/{policyId} {
      allow read: if isActive();
      allow write: if isAdmin();
    }

    match /establishments/{establishmentId} {
      allow read: if isActive();
      allow write: if isAdmin();
    }

    match /notifications/{notificationId} {
      allow read: if isActive()
        && resource.data.userId == request.auth.uid;
      allow update: if isActive()
        && resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['read']);
      allow create, delete: if false;
    }

    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
